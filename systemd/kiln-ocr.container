[Unit]
Description=Kiln OCR Processing Container
After=frigate.service mosquitto.service

[Container]
Image=quay.io/jtligon/kiln-ocr:latest
Volume=/frigate/media:/frigate/media:Z
# Scripts are now built into the container image
Volume=/var/lib/kiln-monitoring/kiln-data:/data:Z
Volume=/var/lib/kiln-monitoring/logs/ocr-processor:/logs:Z
WorkingDirectory=/app
Environment=PYTHONPATH=/app
Environment=TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata
Environment=KILN_DATA_PATH=/data
Environment=LOG_PATH=/logs
Exec=/bin/bash -c "python3 temperature-logger.py & python3 frigate-ocr-integration.py"
Network=host

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target 